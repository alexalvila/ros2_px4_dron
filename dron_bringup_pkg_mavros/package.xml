<?xml version="1.0"?>
<package format="3">
  <name>dron_bringup_pkg_mavros</name>
  <version>0.3.0</version>
  <description>Modo manual ROS 2 + PX4 mediante MAVROS/MAVLink separado del paquete original para dron real con Pixhawk.</description>
  <maintainer email="alexalvila@gmail.com">alex</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>mavros_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>robot_state_publisher</depend>
  <depend>rviz2</depend>
  <depend>mavros</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
